pipeline {
    agent any
    
    stages {
        stage('Checkout Code') {
            steps {
                echo 'Cloning repository...'
                checkout git(url: 'https://github.com/12gauri/devsecops-library-management-system.git', 
                            credentialsId: 'git-credentials')
            }
        }
        
        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                sh 'docker build -t library-app ./app'
            }
        }
        
        stage('Run Container Test') {
            steps {
                echo 'Running container...'
                sh 'docker run -d -p 5000:5000 library-app'
            }
        }
        
        stage('Trivy Scan (Security)') {
            steps {
                echo 'Running security scan...'
                sh '''
                    docker save library-app -o library-app.tar
                    trivy image --input library-app.tar
                    rm library-app.tar
                '''
            }
        }
    }
    
    post {
        always {
            echo 'Pipeline execution completed'
        }
    }
}
