pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        IMAGE_NAME = "library-devsecops-app"
        CONTAINER_NAME = "library-test-container"
    }

    stages {

        stage('Checkout Code') {
            steps {
                echo "Cloning repository from GitHub..."

                git branch: 'main',
                    url: 'https://github.com/12gauri/devsecops-library-management-system.git',
                    credentialsId: 'git-credentials'
            }
        }

        stage('SonarQube Scan') {
            tools {
                // Changed from sonarQubeScanner to sonarRunner
                sonarRunner 'sonar-scanner'
            }
            steps {
                echo "Running SonarQube Analysis..."

                withSonarQubeEnv('SonarQube') {
                    sh """
                        sonar-scanner \
                        -Dsonar.projectKey=library-app \
                        -Dsonar.projectName=Library-App \
                        -Dsonar.sources=.
                    """
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building Docker image..."

                sh """
                    docker build -t $IMAGE_NAME app/
                """
            }
        }

        stage('Run Container Test') {
            steps {
                echo "Running Docker container..."

                sh """
                    docker rm -f $CONTAINER_NAME || true
                    docker run -d --name $CONTAINER_NAME -p 8081:8080 $IMAGE_NAME
                    sleep 10
                    docker ps
                """
            }
        }

        stage('Trivy Scan (Security)') {
            steps {
                echo "Running Trivy security scan..."

                sh """
                    trivy image $IMAGE_NAME
                """
            }
        }
    }

    post {
        always {
            echo "Cleaning up containers..."

            sh """
                docker rm -f $CONTAINER_NAME || true
            """
        }

        success {
            echo "Pipeline executed successfully 🎉"
        }

        failure {
            echo "Pipeline failed ❌ Check logs"
        }
    }
}
