pipeline {
    agent any
    
    stages {
        stage('Checkout Code') {
            steps {
                echo 'Cloning repository from main branch...'
                git branch: 'main', 
                    credentialsId: 'git-credentials', 
                    url: 'https://github.com'
            }
        }
        
        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                sh 'docker build -t library-app ./app'
            }
        }
        
        stage('Run Container Test') {
            steps {
                echo 'Running container test...'
                // Named 'library-test-container' for easy tracking and post-build cleanup
                sh 'docker run -d --name library-test-container -p 5000:5000 library-app'
            }
        }
        
        stage('Trivy Scan (Security)') {
            steps {
                echo 'Running security scan via Trivy Docker container...'
                // Uses official Trivy image and mounts the docker socket to scan the local image
                sh '''
                    docker run --rm \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        -v $HOME/.cache:/root/.cache/ \
                        aquasec/trivy:latest image library-app
                '''
            }
        }
    }
    
    post {
        always {
            echo 'Cleaning up test containers...'
            // Force removes the test container so port 5000 is open for the next run
            sh 'docker rm -f library-test-container || true'
            echo 'Pipeline execution completed'
        }
    }
}
