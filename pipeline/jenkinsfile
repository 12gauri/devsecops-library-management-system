pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    environment {
        IMAGE_NAME = "library-devsecops-app"
        CONTAINER_NAME = "library-test-container"
        SONAR_HOST_URL = "http://sonarqube:9000"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/12gauri/devsecops-library-management-system.git'
            }
        }

        stage('SonarQube Scan') {
            steps {
                echo "Running SonarQube Analysis..."

                withSonarQubeEnv('SonarQube') {
                    sh """
                        sonar-scanner \
                        -Dsonar.projectKey=library-app \
                        -Dsonar.projectName=Library-App \
                        -Dsonar.sources=. \
                        -Dsonar.host.url=${SONAR_HOST_URL}
                    """
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t $IMAGE_NAME app/"
            }
        }

        stage('Run Container Test') {
            steps {
                sh """
                    docker rm -f $CONTAINER_NAME || true
                    docker run -d --name $CONTAINER_NAME -p 8081:8080 $IMAGE_NAME
                    sleep 10
                    docker ps
                """
            }
        }

        stage('Trivy Scan') {
            steps {
                sh "trivy image $IMAGE_NAME"
            }
        }
    }

    post {
        always {
            sh "docker rm -f $CONTAINER_NAME || true"
        }
    }
}
