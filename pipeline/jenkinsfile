pipeline {
    agent any
    
    stages {
        stage('Checkout Code') {
            steps {
                echo 'Cloning repository...'
                git branch: 'main', 
                    credentialsId: 'git-credentials', 
                    url: 'https://github.com/12gauri/devsecops-library-management-system.git'
            }
        }
        
        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                sh 'docker build -t library-app ./app'
            }
        }
        
        stage('Run Container Test') {
            steps {
                echo 'Running container...'
                // Named the container 'library-test-container' for easy cleanup later
                sh 'docker run -d --name library-test-container -p 5000:5000 library-app'
            }
        }
        
        stage('Trivy Scan (Security)') {
            steps {
                echo 'Running security scan...'
                sh '''
                    docker save library-app -o library-app.tar
                    trivy image --input library-app.tar
                    rm library-app.tar
                '''
            }
        }
    }
    
    post {
        always {
            echo 'Cleaning up test containers...'
            // Stops and removes the container regardless of whether the pipeline succeeds or fails
            sh 'docker rm -f library-test-container || true'
            echo 'Pipeline execution completed'
        }
    }
}
